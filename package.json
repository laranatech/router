{
	"name": "@laranatech/router",
	"version": "2.0.1",
	"description": "router",
	"keywords": [
		"routing",
		"larana"
	],
	"license": "MIT",
	"author": "Evgenii Kucheriavii",
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		"import": "./dist/index.js",
		"require": "./dist/index.cjs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/laranatech/router.git"
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
