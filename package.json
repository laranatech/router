		"check": "npm run lint & npm run ts-check",
		"build": "tsup"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"eslint": "^9.39.4",
		"globals": "^16.5.0",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.2",
		"vitest": "^3.2.4"
